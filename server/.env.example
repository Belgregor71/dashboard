# Server
PORT=3001

# Location — used by weather route and day-rail
LAT=-27.4705
LON=153.0260
LOCATION_NAME=Brisbane

# Calendar — comma-separated private iCal share URLs
# Google Calendar: share the calendar → "Get shareable link" → copy the .ics URL
# iCloud:  System Settings → iCloud → Calendar → share → copy .ics link
# TripIt:  tripit.com → Account → Preferences → Calendar Sync → export iCal URL
CALENDAR_ICAL_URLS=

# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Override entity IDs for the smart-home card (comma-separated)
# HA_ENTITIES=light.living_room,light.kitchen,switch.coffee_machine,climate.bedroom

# News — any RSS/Atom feed URL. Default is ABC News Australia top stories.
# NEWS_RSS_URL=https://www.abc.net.au/news/feed/51120/rss.xml
# NEWS_SOURCE=ABC

# Admin photo manager — set a password to enable /admin/photos
# Leave blank to disable the admin page entirely
ADMIN_PASSWORD=
