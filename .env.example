PORT=3000
# Home Assistant is enabled by default. Set HA_ENABLED=0 to boot the dashboard without HA while debugging.
# Leaving HA_HOST or HA_TOKEN blank has the same effect: the integration turns
# itself off and /api/ha/* answers 503, rather than taking the whole dashboard
# down with it (audit 2026-07-26, M1). Watch the boot log for "[ha] integration
# disabled" if HA looks dead — that is a missing variable, not a dead HA.
HA_ENABLED=1
HA_HOST=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_token
# go2rtc base URL — enables live camera popups (/api/camera/:id/live)
GO2RTC_HOST=http://192.168.x.x:1984
CALENDAR_DEBUG=0
HOME_BASE=

# Watchdog push notifications — HA notify service for degraded/recovered alerts
# (the part after "notify." e.g. mobile_app_your_phone; list via HA → Developer
# Tools → Services). Leave blank to disable push; on-screen indicator still works.
HEALTH_NOTIFY_SERVICE=

# Server-side location — used by /api/weather/now, /api/weather/forecast,
# the briefing/concierge AI context, and (as the fuel-search center) fuel.js.
# Required even though the frontend has its own copy in src/js/config/config.js —
# the two are not shared, and omitting this silently degrades weather to nulls.
WEATHER_LAT=-27.3691
WEATHER_LON=153.0847

# Bin day reminder
# BIN_COLLECTION_DAY: day of week — number (0=Sun … 6=Sat) or full name e.g. Tuesday
# BIN_YELLOW_REFERENCE: any past date when yellow (recycling) bins were collected (ISO format)
#   Leave BIN_YELLOW_REFERENCE blank to show only the red bin reminder.
BIN_COLLECTION_DAY=
BIN_YELLOW_REFERENCE=

# Claude API — primary generator for briefings and the ambient concierge line.
# Get a key at https://platform.claude.com — a briefing costs ~$0.001 on Haiku.
# Leave blank to use Ollama only (Ollama is always the fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Local AI (Ollama) — runs on your Synology NAS via Docker
# OLLAMA_URL: base URL of the Ollama container (no trailing slash)
# OLLAMA_MODEL: model name as pulled e.g. llama3.2:1b or llama3.2:3b
OLLAMA_URL=http://192.168.x.x:11434
OLLAMA_MODEL=llama3.2:1b

# Local TTS (Kokoro-FastAPI) — runs on the same NAS via Docker
# KOKORO_URL: base URL of the Kokoro-FastAPI container (no trailing slash)
# KOKORO_VOICE: voice id, e.g. bf_emma (British female) — GET /v1/audio/voices for the full list.
#   "a+b(+c…)" is an equal-weight blend of those voices' style vectors, understood
#   by BOTH the PC tts_server and the NAS Kokoro-FastAPI, so the two upstreams
#   produce the identical voice. The house voice is the blend below.
# GOTCHA: the TTS disk cache key does NOT include the voice — clear
#   server/tts-cache/*.wav after changing this or you keep hearing the old one.
KOKORO_URL=http://192.168.x.x:8880
KOKORO_VOICE=bm_george+bm_lewis

# QLD Fuel Prices — fuelpricesqld.com.au (FPDAPI)
# Register at https://www.fuelpricesqld.com.au to get a free SubscriberToken.
# FUEL_RADIUS_KM: search radius from your location (uses WEATHER_LAT / WEATHER_LON,
#   falling back to LAT / LON). Code default is 10 if unset.
# NOTE: the fuel type is NOT configurable — server/routes/fuel.js hardcodes
# FUEL_ID = 2 (Unleaded). A FUEL_TYPES key was documented here for a long time
# and was read by nothing; it has been removed rather than left to mislead.
FUEL_API_KEY=
FUEL_RADIUS_KM=5

# Commute panel — TomTom Routing API (free tier, no credit card required)
# Sign up at https://developer.tomtom.com to get a free API key.
TOMTOM_API_KEY=

# Immich photo library — Phase 9.5 (docs/vision/photo-source-immich.md)
# The household's photo server (Synology). Read-only: the memory engine +
# screensaver pull downscaled renditions through the server proxy; the key never
# reaches the browser. Generate a key in Immich → Account Settings → API Keys.
# Unset → the dashboard falls back to static/photos/ (feature is a no-op).
IMMICH_URL=http://192.168.x.x:2283
IMMICH_API_KEY=

# Static map tiles for the "Daily Memories" screensaver (features.dailyMemories).
# Travel photos (taken outside Australia) show a small map pin at their GPS coords.
# The key is server-side only (proxied + disk-cached via /api/immich/map). Default
# provider is the Mapbox Static Images API — get a token at mapbox.com. Unset →
# no map tile (the year·place caption still shows). MAP_STYLE optional (default
# dark-v11).
MAP_API_KEY=
MAP_STYLE=

# --- Security (audit 2026-07-26, S1/S2/S3) --------------------------------
# The billable routes (/api/tts/speak, /api/ai/brief, /api/voice/converse and
# the /api/recipe?dish= web search) are restricted to loopback, because the
# kiosk's chromium runs on the Pi itself against http://localhost:3000. Set
# ALLOW_LAN_COST_ROUTES=1 to re-open them to the whole LAN — needed only if you
# want TTS and AI copy while reading the dashboard from a phone.
ALLOW_LAN_COST_ROUTES=

# Per-IP flood ceiling on /api, in requests per minute. Loopback is exempt: a
# single kiosk IP legitimately bursts past 2000/min on a cold page load.
API_RATE_LIMIT=600

# Cross-origin allowlist, comma-separated (e.g. http://192.168.0.50:8080).
# Empty = same-origin only, which is what the kiosk and both LAN portals need.
CORS_ALLOWED_ORIGINS=

# The Content-Security-Policy ships as report-only until a live Pi pass confirms
# zero violations. Set to 1 to enforce it. NOTE: /admin/photos still uses an
# inline <script> and an onclick handler, which an enforcing CSP will block.
CSP_ENFORCE=

# Total byte ceiling for server/tts-cache (oldest evicted first). The 14-day age
# prune alone cannot stop a burst of unique text filling the SD card.
TTS_CACHE_MAX_BYTES=104857600

# --- House knowledge base (Obsidian vault) --------------------------------
# Set to 1 to let the voice concierge answer questions from notes the household
# writes in Obsidian (docs/design/VAULT.md). The vault is a plain folder of
# markdown files at data/vault/ — clone your private notes repo there; Obsidian
# itself never runs on the Pi.
#
# Unset (the default) is fully inert: the routes are not mounted, the index is
# never built, and the concierge's prompt is byte-identical to the pre-vault
# one. Unsetting it is the rollback path.
#
# PRIVACY: retrieved note text is sent to Anthropic on the concierge's Claude
# leg. `private: true` in a note's frontmatter keeps it out of the index
# entirely. The default is EXPOSURE — do not put anything in the vault you
# would not send upstream.
VAULT_ENABLED=

# --- Admin ----------------------------------------------------------------
# Enables /admin/photos (upload + delete of static/photos). Blank = the admin
# page is disabled entirely. Required for the photo manager, nothing else.
ADMIN_PASSWORD=

# --- Calendars ------------------------------------------------------------
# Private iCal share URLs, one per source. All three are optional and read
# independently — there is no combined list.
#   Google: calendar settings → "Secret address in iCal format"
#   Apple:  iCloud → Calendar → share → copy the .ics link
#   TripIt: tripit.com → Account → Preferences → Calendar Sync → iCal URL
# (A legacy CALENDAR_ICAL_URLS key appears in server/.env.example. Nothing
# reads it — use the three below.)
CALENDAR_GOOGLE_URL=
CALENDAR_APPLE_URL=
CALENDAR_TRIPIT_URL=

# --- Media: Plex ----------------------------------------------------------
# PLEX_ALLOW_INSECURE: exactly the string "true" to skip TLS verification for a
# self-signed Plex certificate. Any other value (including "1") keeps it on.
PLEX_BASE_URL=
PLEX_TOKEN=
PLEX_ALLOW_INSECURE=

# --- Media: Sonarr / Radarr / Lidarr --------------------------------------
# Download-queue tiles. Each service is independent; leave a pair blank to skip
# it. URL is the base (no trailing slash), key is from Settings → General.
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=

# --- Cameras: Eufy --------------------------------------------------------
# eufy-security-ws endpoint (see project-eufy-event-gap). Defaults in code to
# ws://192.168.0.179:3000 — the Synology — so set this if yours differs.
EUFY_WS_URL=

# --- News -----------------------------------------------------------------
# Any RSS/Atom feed. Defaults to ABC News Australia top stories.
# NEWS_SOURCE is the short label rendered on the tile (code default "NEWS").
NEWS_RSS_URL=
NEWS_SOURCE=

# --- Status view ----------------------------------------------------------
# Reachability probe target for the connectivity row. Code default https://1.1.1.1
STATUS_PING_TARGET=

# --- Recipes --------------------------------------------------------------
# Model used by /api/recipe?dish= to fetch a recipe. Code default claude-haiku-4-5.
RECIPE_MODEL=

# --- Self-heal ------------------------------------------------------------
# Comma-separated HA switch entity ids the recovery service re-arms when motion
# detection silently turns itself off. Defaults to switch.kitchen_motion_detection.
RECOVERY_DETECTION_SWITCHES=

# --- TTS failover ---------------------------------------------------------
# Optional second Kokoro endpoint. KOKORO_URL above is the primary (the fast PC,
# ~1s); set this to the always-on NAS Kokoro for when the PC is asleep. When a
# fallback IS set, the primary gets a short timeout so failover is quick — with
# it unset, behaviour is a single upstream exactly as before.
KOKORO_FALLBACK_URL=

# --- BOM weather (optional, Home Assistant BOM integration) ---------------
# All optional: unset simply means the Weather view falls back to Open-Meteo.
# This integration exposes each field as its own flat sensor entity rather than
# attributes on one forecast entity, so every slot below is a full entity id.
# The 5/6/7 suffixes are forecast day SLOTS, not day offsets — slot 5 is TODAY
# (see DAY_SLOT_MAP in src/js/services/weather/bom.js). Slot 5 is the only one
# the Weather view currently reads.
BOM_LOCATION_NAME=
BOM_WARNINGS_ENTITY_ID=
BOM_HOURLY_ENTITY_ID=

BOM_D5_ENTITY_ID=
BOM_RAIN_CHANCE_5=
BOM_RAIN_RANGE_5=
BOM_UV_CATEGORY_5=
BOM_UV_MAX_5=

BOM_D6_ENTITY_ID=
BOM_RAIN_CHANCE_6=
BOM_RAIN_RANGE_6=
BOM_UV_CATEGORY_6=
BOM_UV_MAX_6=

BOM_D7_ENTITY_ID=
BOM_RAIN_CHANCE_7=
BOM_RAIN_RANGE_7=
BOM_UV_CATEGORY_7=
BOM_UV_MAX_7=

# --- Legacy aliases (accepted, but prefer the names above) ----------------
# These are read only as fallbacks and exist because an older server/.env used
# them. Setting BOTH names is the classic source of "why is it pointing at the
# wrong host" — CLAUDE.md calls this out. Prefer HA_HOST / WEATHER_LAT / WEATHER_LON.
#   HA_URL  → fallback for HA_HOST
#   LAT/LON → fallback for WEATHER_LAT / WEATHER_LON (fuel.js only)
# HA_URL=
# LAT=
# LON=

# --- Debug flags (set to exactly "1" to enable) ---------------------------
HA_DEBUG=
DEBUG_HA_PROXY=
WEATHER_DEBUG_BOM=

# --- Dev / test / script only (not needed to run the dashboard) -----------
# DASHBOARD_URL          scripts/pregenerate-tts-cache.js target (default http://localhost:3000)
# DASH_URL               scripts/fault-injection.mjs target   (default http://192.168.0.183:3000)
# PI_SSH                 ssh host alias used by scripts       (default pi-dashboard)
# RECOVERY_TEST_SWITCH   switch id for the recovery test      (default switch.kitchen_motion_detection)
# HA_WS_TEST_TIMEOUT_MS  HA websocket probe timeout in ms     (default 12000)
