PORT=3000
# Home Assistant is enabled by default. Set HA_ENABLED=0 to boot the dashboard without HA while debugging.
HA_ENABLED=1
HA_HOST=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_token
# go2rtc base URL — enables live camera popups (/api/camera/:id/live)
GO2RTC_HOST=http://192.168.x.x:1984
CALENDAR_DEBUG=0
HOME_BASE=

# Watchdog push notifications — HA notify service for degraded/recovered alerts
# (the part after "notify." e.g. mobile_app_your_phone; list via HA → Developer
# Tools → Services). Leave blank to disable push; on-screen indicator still works.
HEALTH_NOTIFY_SERVICE=

# Server-side location — used by /api/weather/now, /api/weather/forecast,
# the briefing/concierge AI context, and (as the fuel-search center) fuel.js.
# Required even though the frontend has its own copy in src/js/config/config.js —
# the two are not shared, and omitting this silently degrades weather to nulls.
WEATHER_LAT=-27.4698
WEATHER_LON=153.0251

# Bin day reminder
# BIN_COLLECTION_DAY: day of week — number (0=Sun … 6=Sat) or full name e.g. Tuesday
# BIN_YELLOW_REFERENCE: any past date when yellow (recycling) bins were collected (ISO format)
#   Leave BIN_YELLOW_REFERENCE blank to show only the red bin reminder.
BIN_COLLECTION_DAY=
BIN_YELLOW_REFERENCE=

# Claude API — primary generator for briefings and the ambient concierge line.
# Get a key at https://platform.claude.com — a briefing costs ~$0.001 on Haiku.
# Leave blank to use Ollama only (Ollama is always the fallback).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Local AI (Ollama) — runs on your Synology NAS via Docker
# OLLAMA_URL: base URL of the Ollama container (no trailing slash)
# OLLAMA_MODEL: model name as pulled e.g. llama3.2:1b or llama3.2:3b
OLLAMA_URL=http://192.168.x.x:11434
OLLAMA_MODEL=llama3.2:1b

# Local TTS (Kokoro-FastAPI) — runs on the same NAS via Docker
# KOKORO_URL: base URL of the Kokoro-FastAPI container (no trailing slash)
# KOKORO_VOICE: voice id, e.g. bf_emma (British female) — GET /v1/audio/voices for the full list
KOKORO_URL=http://192.168.x.x:8880
KOKORO_VOICE=bf_emma

# QLD Fuel Prices — fuelpricesqld.com.au (FPDAPI)
# Register at https://www.fuelpricesqld.com.au to get a free SubscriberToken.
# FUEL_TYPES: comma-separated fuel codes to display (E10, U91, P95, P98, PDL)
# FUEL_RADIUS_KM: search radius from your location (uses WEATHER_LAT / WEATHER_LON)
FUEL_API_KEY=
FUEL_TYPES=E10,U91
FUEL_RADIUS_KM=5

# Commute panel — TomTom Routing API (free tier, no credit card required)
# Sign up at https://developer.tomtom.com to get a free API key.
TOMTOM_API_KEY=
