node_modules/
# `.env` alone left every sibling copy committable, and this repo is PUBLIC.
# Found 2026-08-02: an untracked `.env.pre-cleanup` (9 lines of tokens/keys,
# left over from the G11 migration) was sitting in the kiosk's checkout, one
# `git add -A` away from being published. Backups are the normal way to edit a
# live .env, so ignore the whole family rather than trusting nobody typos.
.env
.env.*
!.env.example
.pm2
logs
dist/
.claude/
*.env.local
screenshot*.png
.reference/
static/photos/
CLAUDE_CODE_PROMPT.md
server/package.json
server/package-lock.json
server/tts-cache/
data/routines/
data/memories/
data/immich-cache/
data/delight/
data/recipe-cache/
# The house knowledge base is a SEPARATE private git repo cloned in here
# (docs/design/VAULT.md). Ignored so the nested clone never shows up as a
# stray gitlink in this repo's status.
data/vault/

# Playwright MCP tool artifacts
.playwright-mcp/
static/js/

# Playwright test artifacts
test-results/
playwright-report/
flag-reversibility-failure.log

# PC-side voice services (Stage B, project-voice-mic-bridge) — venv/models/caches/logs
tools/voice-pc/.venv/
tools/voice-pc/models/
tools/voice-pc/*.log
tools/voice-agent/*.log
**/__pycache__/
*.pyc
