{
  "name": "family-dashboard",
  "version": "1.0.0",
  "description": "Raspberry Pi smart home dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build && node scripts/copy-static-config.js",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ha-ws-proxy": "node scripts/test-ha-ws-proxy.js",
    "pregen:tts": "node scripts/pregenerate-tts-cache.js",
    "verify:contrast": "playwright test --config playwright.verify.config.js",
    "verify:flags": "node scripts/verify/flag-reversibility.mjs",
    "verify:patterns": "node scripts/verify/scan-patterns.mjs",
    "verify:contracts": "node scripts/verify/scan-contracts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "ajv": "^8.17.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^3.0.0",
    "lottie-web": "^5.13.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "node-ical": "^0.22.1",
    "ws": "^8.18.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belgregor71/dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Belgregor71/dashboard/issues"
  },
  "homepage": "https://github.com/Belgregor71/dashboard#readme",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
