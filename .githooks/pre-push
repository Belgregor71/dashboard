#!/bin/sh
# Pushing to main deploys straight to the Pi kiosk (dashboard-deploy.timer
# pulls origin/main). This gate makes a broken push much harder:
#   1. the exact build the Pi will run must succeed locally
#   2. API contract tests + browser smoke test must pass
#   3. known-defect patterns in the outgoing diff (slug guards, hook order,
#      brightness clamps) must be absent
#   4. worst-case text contrast across all 8 atmosphere tokens must clear WCAG AA
#   5. any ON flag whose code this diff touches must still be cleanly flippable off
#
# Gates 1-5 are everything checkable WITHOUT the Pi. The Pi cannot be verified
# here at all: deploys are pull-based from origin/main, so the Pi has no way to
# see this code until after the push succeeds. Live kiosk verification is the
# `/verify-push` skill, run immediately after pushing.
#
# Wire it up once per clone:  git config core.hooksPath .githooks
# Emergency bypass (know what you're doing): git push --no-verify

set -e

echo "[pre-push] 1/5 build gate (the Pi runs this same build on deploy)"
npm run build

echo "[pre-push] 2/5 API contract + browser smoke tests"
npm test

echo "[pre-push] 3/5 known-defect pattern scan"
node scripts/verify/scan-patterns.mjs

echo "[pre-push] 4/5 worst-case contrast sweep (8 atmosphere tokens)"
npm run verify:contrast

echo "[pre-push] 5/5 flag reversibility (diff-scoped)"
node scripts/verify/flag-reversibility.mjs

echo ""
echo "[pre-push] all local gates passed."
echo "[pre-push] the Pi is NOT verified yet — run /verify-push after this push lands."
