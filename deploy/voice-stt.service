[Unit]
# faster-whisper STT on the kiosk host itself, REPLACING the PC as the only
# transcriber (not a fallback — see below).
#
# WHY THIS EXISTS: the mic agent posted captured audio to whisper on the PC, and
# voice_agent.py's transcribe() has no fallback at all — it logs "STT unreachable"
# and DROPS THE TURN. So an overnight PC meant the house was deaf, which is a
# louder failure than a slow reply: nothing happens and nothing explains why.
#
# ⚠ MEASURED 2026-08-16, and it is the opposite result to the TTS leg: this box
# transcribes a 2.67 s utterance in 1.19-1.30 s (RTF ~0.46), against the PC's
# recorded 1.27 s for a 2.2 s clip. It is not a compromise, it is a wash — so
# this is a STRAIGHT SWITCH, not a chain. CTranslate2 int8 is CPU-optimised in a
# way kokoro-onnx is not; do not assume the TTS verdict transfers here.
#
# Adding a PC fallback would only reintroduce a timeout on the path that is
# already the deaf one. Don't, without a reason.
Description=Whisper STT for the dashboard voice agent (always-up, local)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
WorkingDirectory=/home/dashboard/voice-stt
ExecStart=/home/dashboard/voice-stt/.venv/bin/python /home/dashboard/voice-stt/stt_server.py

# Loopback only — the mic agent runs on this same box. Audio reaching this port
# has already passed the on-device wake gate, and it now never leaves the host
# at all, which is strictly stronger than the original LAN guarantee.
Environment=STT_HOST=127.0.0.1
Environment=STT_PORT=8123
Environment=STT_MODEL=base.en
Environment=STT_DEVICE=cpu
Environment=STT_COMPUTE=int8
Environment=OMP_NUM_THREADS=4

# ── Decode hardening + the shadow leg (2026-08-22) ───────────────────────────
# ⚠ ALL UNSET BY DEFAULT, AND THAT IS THE ROLLBACK. stt_server.py builds its
# extra decode arguments from these and inserts NOTHING when they are unset, so
# the unit as shipped transcribes byte-identically to the one measured at
# 1185 ms for 6400 ms of audio. Uncomment, `systemctl daemon-reload`, restart.
#
# Two failures these answer, both on the record:
#   "hanging the washing out"  -> "hanging out the washy"   (domain nouns)
#   3.4 s of room tone         -> "Okay."                    (hallucination)
#
# ⚠⚠ MEASURE BEFORE SWAPPING THE ENGINE. STT_SHADOW_MODEL runs a second model on
# the same bytes, off the response path, and logs where the two disagree — real
# room speech, no audio stored. That is what says whether the MODEL is the limit
# or the DECODE SETTINGS are. The one previous attempt to benchmark this fed
# Kokoro-synthesised speech and got a perfect transcript while the room was
# being misheard; do not repeat it.
#
# Environment=STT_CONDITION_PREV=0
# Environment=STT_NO_SPEECH=0.6
# Environment=STT_TEMPERATURE=0
# Environment=STT_HOTWORDS_FILE=/home/dashboard/voice-stt/hotwords.txt
# Environment=STT_SHADOW_MODEL=small.en
#
# ⚠ The shadow loads a SECOND model into a service capped at MemoryMax=2G.
# base.en int8 is ~75 MB and small.en ~250 MB, so the pair is comfortable — but
# check `systemctl status voice-stt` for an OOM kill after enabling it, because
# the failure mode of that cap is a restart loop, i.e. a deaf house.

# Same bounding as voice-tts.service. Measured under a pathologically sustained
# transcription loop: gpu-process 5.1, renderer 5.3, substrateFps 15, pressure
# avg10 0.01, 46 °C — i.e. the wall did not notice.
Nice=10
CPUWeight=20
MemoryMax=2G

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
